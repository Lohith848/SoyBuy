# ============================================================================
# SoyBuy - Production Git Ignore Configuration
# ============================================================================

# --- Environment & Secret Files (CRITICAL: NEVER COMMIT SECRETS) ---
.env
.env*.local
.env.development
.env.test
.env.production
*.pem
*.key
*.cert
*.p12

# Explicit exception for template
!.env.example

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
.venv/
venv/
ENV/
env/
.uv/

# --- Node.js & Next.js ---
node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnp.*
.next/
out/
.vercel/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Testing, Coverage & Type Checking ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.lcov
.hypothesis/
.mypy_cache/
.ruff_cache/

